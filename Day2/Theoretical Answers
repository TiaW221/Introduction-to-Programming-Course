 6. A man may be admitted to the club if he is wearing a shirt and shoes. Write some
   pseudocode to output a yes/no value indicating whether the man may be admitted
   to the club.

DEFINE shoesWorn = false
DEFINE shirtWorn = false
DEFINE clubEntry = false
DEFINE outputResponse = ''

OUTPUT "Are shoes worn? Yes/No" = outputResponse
INPUT outputResponse
IF outputResponse = "Yes"
    shoesWorn = true
END IF

OUTPUT "Is shirt worn? Yes/No" = outputResponse
INPUT outputResponse
IF outputResponse = "Yes"
    shirtWorn = true
END IF

IF shoesWorn && shirtWorn
    clubEntry = true
END IF


